# Environment Configuration for Voice-Enabled RAG Pipeline

# Application Setup
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Speech-to-Text Configuration (Pick Sarvam or ElevenLabs)
STT_PROVIDER=sarvam  # Options: sarvam | elevenlabs
SARVAM_API_KEY=your_sarvam_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# LLM / Generation Configuration
LLM_PROVIDER=groq  # Options: groq | openai | custom
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=llama-3.1-8b-instant

# Embedding / Retrieval Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
VECTOR_DB_TYPE=faiss  # Options: faiss | qdrant | memory

# Performance & SLA Targets
MAX_LATENCY_SLA_MS=200
